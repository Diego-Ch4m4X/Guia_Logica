{
  "name": "guia-logica-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preflight": "node scripts/preflight.js",
    "build": "node scripts/build.js",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/contracts/*.test.js",
    "validate:pages": "node scripts/validate-pages-artifact.js",
    "validate:html": "vnu --errors-only --skip-non-html dist",
    "validate:js": "node scripts/check-js-syntax.js",
    "check:external-links": "node scripts/check-external-links.js"
  },
  "version": "1.2.0",
  "devDependencies": {
    "vnu-jar": "26.8.30"
  }
}
